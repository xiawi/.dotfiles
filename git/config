[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[core]
	editor = nvim
	excludesFile = ~/.gitignore_global
[color]
	ui = auto
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[alias]
	unstage = restore --staged
	amend = commit --amend --no-edit
	last = log -1 HEAD
	graph = log --oneline --decorate --graph --all
